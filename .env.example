# Copy to `.env` and fill in. Vite only exposes vars prefixed with VITE_.
# `.env` is gitignored — never put a real key in THIS file, it is committed.

# --- Contact form -------------------------------------------------------------
# Without this the contact form is DISABLED and says so on the page. It will not
# pretend to send. Get a free key (no server needed, delivers straight to an
# inbox) at https://web3forms.com — enter the office email, copy the key here.
#
# For production: set this in your host's environment settings (Vercel →
# Settings → Environment Variables), not in the repo. Vite inlines VITE_* vars
# into the client bundle at build time, so the build needs it present.
VITE_WEB3FORMS_KEY=

# ---------------------------------------------------------------- admin panel
# Server-side only. These are read by api/publish.js, which runs on Vercel and
# never ships to the browser. Set them in Vercel > Settings > Environment
# Variables — NOT in this file, and never in a commit: this repository is
# public.
#
# ADMIN_PASSWORD  a long random string; the only thing guarding /admin
# GITHUB_TOKEN    a fine-grained personal access token with
#                 Contents: read and write, scoped to THIS repository only
# GITHUB_REPO     optional, defaults to shivaganeshtalikota/THK-Website
# GITHUB_BRANCH   optional, defaults to main
# GEMINI_API_KEY  optional. Enables the "draft it from an article" toggle in the
#                 admin panel. Without it that button reports the feature is off
#                 and captions are typed by hand; nothing else changes.
ADMIN_PASSWORD=
GITHUB_TOKEN=
GEMINI_API_KEY=

# ------------------------------------------------------- poster link previews
# Server-side only, read by api/poster-card.js and api/card.js. Set them in
# Vercel > Settings > Environment Variables — NOT here, and never in a commit:
# this repository is public.
#
# These let a supporter opt in to having their own finished poster appear as the
# preview image when their link is forwarded. Link crawlers do not run
# JavaScript, so that image has to exist at a URL; there is no client-side way
# round it. Only the 1200x630 card is stored — never the photograph, never the
# full-size poster — under an unguessable id, and a Cloudflare lifecycle rule on
# the "cards/" prefix deletes it after 30 days.
#
# WITHOUT THESE the feature degrades rather than breaks: the opt-in button
# reports that previews are unavailable, and every link still works and previews
# as the campaign card.
#
# R2_ACCOUNT_ID          Cloudflare account id
# R2_ACCESS_KEY_ID       R2 S3 access key, scoped to this one bucket
# R2_SECRET_ACCESS_KEY   its secret
# R2_BUCKET              bucket name
# POSTER_CARDS_ENABLED   optional kill switch. Set to "0" to refuse new uploads
#                        without a deploy; existing links keep working.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
POSTER_CARDS_ENABLED=

# ------------------------------------------------------ inbound mail forwarding
# Server-side only, read by api/inbound-mail.js. Set them in Vercel > Settings >
# Environment Variables — NOT here, and never in a commit: this repo is public.
#
# Resend receives mail for the domain but has NO standing forwarding rule —
# messages land in its dashboard and forwarding is a per-message action. That is
# not good enough for a contact address whose purpose is letting a stranger ask
# for their photograph to be taken down, so this webhook forwards each message
# into a real inbox as it arrives.
#
# The signature check is the security boundary: this endpoint sends mail AS the
# verified domain, so without it anyone could make the site emit email that
# passes SPF and DKIM for talikotaharikrishna.com.
#
# RESEND_API_KEY          a SENDING key for the verified domain (not full access)
# RESEND_WEBHOOK_SECRET   the whsec_... secret shown when the webhook is created
# INBOUND_FORWARD_TO      the inbox that should receive forwarded mail
# INBOUND_FORWARD_FROM    optional; defaults to forward@talikotaharikrishna.com
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
INBOUND_FORWARD_TO=
INBOUND_FORWARD_FROM=
